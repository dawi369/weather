<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>WeatherSnow</AssemblyName>
    <RootNamespace>Weather</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Optimize Condition="'$(Configuration)'=='Release'">true</Optimize>
  </PropertyGroup>

  <!-- Set by the GitHub workflow (-p:OfficialBuild=true). Only official builds update themselves. -->
  <ItemGroup Condition="'$(OfficialBuild)' == 'true'">
    <AssemblyMetadata Include="OfficialBuild" Value="true" />
  </ItemGroup>

</Project>
